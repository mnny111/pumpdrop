# Start read-only. Change to true only after configuration and funded validation.
LIVE_ENABLED=false
MAIN_TOKEN_MINT=
SOLANA_RPC_URL=
# Railway: paste your base58 Solana private key, used only in server memory.
TREASURY_PRIVATE_KEY=
# Optional legacy JSON alternative. Set only ONE treasury key source.
TREASURY_KEYPAIR_JSON=
# Local file alternative. Leave blank when using either environment key.
TREASURY_KEYPAIR_PATH=
# Optional: leave empty for standard public pack purchases.
COLLECTOR_CRYPT_API_KEY=
JUPITER_API_KEY=
# Every 60 seconds: highest affordable pack; remainder carries forward.


# Required explicit limits. Live catalogue prices: 25, 250, 5000, 1000, 500, 500 USDC.
MAX_PACK_USD=
DAILY_PACK_BUDGET_USD=
MAX_SWAP_SOL=
MIN_SOL_RESERVE=0.02
SLIPPAGE_BPS=50
# Smallest raw token-unit balance eligible. All positive balances by default.
MIN_HOLDER_RAW=1
# Comma-separated wallet addresses: team, exchange custody, burn or other ineligible owners.
# Treasury and all off-curve owners are automatically excluded.
EXCLUDED_HOLDERS=
# Use a dedicated treasury: direct creator wallet OR on-chain Pump fee-sharing recipient.
DEDICATED_CREATOR_CONFIRMED=false
# Mount a persistent volume here. One worker replica only.
# Leave blank to auto-use RAILWAY_VOLUME_MOUNT_PATH (local default: ./data).
DATA_DIR=
PORT=4173
